<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/home_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:focusableInTouchMode="true"
        android:orientation="vertical"
        android:paddingHorizontal="18dp"
        android:paddingTop="14dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:accessibilityHeading="true"
                android:fontFamily="sans-serif-medium"
                android:text="@string/app_name"
                android:textColor="@color/home_text"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/home_network_mode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/home_inset"
                android:fontFamily="sans-serif-medium"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp"
                android:text="@string/online_allowed"
                android:textColor="@color/home_mint"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/home_preview_warning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/home_warning"
            android:textSize="14sp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/home_hero"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="14dp"
            android:paddingTop="8dp"
            android:paddingBottom="13dp">

            <fr.nexuscompanion.android.NexusAvatarView
                android:id="@+id/nexus_avatar"
                android:layout_width="match_parent"
                android:layout_height="156dp"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/home_presence"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/home_inset"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingHorizontal="13dp"
                android:paddingVertical="5dp"
                android:text="@string/home_presence_ready"
                android:textColor="@color/home_muted_text"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/home_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/local_ready"
                android:textColor="@color/home_muted_text"
                android:textSize="13sp" />

            <Button
                android:id="@+id/home_face_mode"
                style="@style/HomeAction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:text="@string/full_face_mode" />
        </LinearLayout>

        <LinearLayout
            style="@style/HomeCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <TextView
                style="@style/HomeHeading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:text="@string/home_voice" />

            <Button
                android:id="@+id/home_speak_now"
                style="@style/HomePrimaryAction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:drawableStart="@drawable/ic_home_microphone"
                android:drawableTint="@color/home_primary_text"
                android:enabled="false"
                android:text="@string/speak_now" />

            <Button
                android:id="@+id/home_microphone"
                style="@style/HomeAction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/activate_microphone" />

            <ProgressBar
                android:id="@+id/home_microphone_level"
                style="@android:style/Widget.Material.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="5dp"
                android:layout_marginTop="10dp"
                android:contentDescription="@string/microphone_level"
                android:max="100"
                android:maxHeight="5dp"
                android:minHeight="5dp"
                android:progressBackgroundTint="@color/home_control"
                android:progressTint="@color/home_mint" />

            <Switch
                android:id="@+id/home_spoken_replies"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:saveEnabled="false"
                android:switchPadding="12dp"
                android:text="@string/spoken_replies"
                android:textColor="@color/home_text"
                android:textSize="15sp" />
        </LinearLayout>

        <LinearLayout
            style="@style/HomeCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <TextView
                style="@style/HomeHeading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:text="@string/home_conversation" />

            <TextView
                android:id="@+id/home_transcript"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:ellipsize="end"
                android:maxLines="4"
                android:textColor="@color/home_sky"
                android:textSize="14sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/home_answer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:accessibilityLiveRegion="polite"
                android:lineSpacingExtra="3dp"
                android:text="@string/greeting"
                android:textColor="@color/home_text"
                android:textSize="19sp" />

            <TextView
                android:id="@+id/home_answer_source"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:textColorLink="@color/home_sky"
                android:textSize="14sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/home_playback_notice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/home_warning"
                android:textSize="14sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/home_retain"
                style="@style/HomeAction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/retain_proposal"
                android:visibility="gone" />

            <EditText
                android:id="@+id/home_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/home_inset"
                android:hint="@string/input_hint"
                android:importantForAutofill="no"
                android:inputType="textCapSentences"
                android:maxLength="2000"
                android:minHeight="52dp"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp"
                android:saveEnabled="false"
                android:singleLine="true"
                android:textColor="@color/home_text"
                android:textColorHint="@color/home_muted_text"
                android:textSize="16sp" />

            <Button
                android:id="@+id/home_send"
                style="@style/HomePrimaryAction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="9dp"
                android:minWidth="112dp"
                android:text="@string/send" />
        </LinearLayout>

        <LinearLayout
            style="@style/HomeCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <TextView
                style="@style/HomeHeading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:text="@string/home_memory" />

            <Button
                android:id="@+id/home_notes"
                style="@style/HomeAction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:text="@string/my_notes" />

            <Button
                android:id="@+id/home_remember"
                style="@style/HomeAction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/remember" />
        </LinearLayout>

        <LinearLayout
            style="@style/HomeCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <TextView
                style="@style/HomeHeading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:text="@string/home_settings" />

            <Switch
                android:id="@+id/home_online_access"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:saveEnabled="false"
                android:switchPadding="12dp"
                android:text="@string/online_access"
                android:textColor="@color/home_text"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/online_access_hint"
                android:textColor="@color/home_muted_text"
                android:textSize="14sp" />

            <Button
                android:id="@+id/home_voice_settings"
                style="@style/HomeAction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:text="@string/voice_settings" />

            <Button
                android:id="@+id/home_updates"
                style="@style/HomeAction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/updates" />

            <Button
                android:id="@+id/home_about"
                style="@style/HomeAction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/about" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
