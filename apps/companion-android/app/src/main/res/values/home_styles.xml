<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="home_background">#0B1221</color>
    <color name="home_panel">#141F34</color>
    <color name="home_outline">#2B3B55</color>
    <color name="home_inset">#10192B</color>
    <color name="home_control">#202D44</color>
    <color name="home_text">#F1F5FC</color>
    <color name="home_muted_text">#B3C0D5</color>
    <color name="home_mint">#A0EEDB</color>
    <color name="home_violet">#C8BAFF</color>
    <color name="home_sky">#A6D7FF</color>
    <color name="home_warning">#FFD1BC</color>

    <style name="NexusHomeTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/home_background</item>
        <item name="android:statusBarColor">@color/home_background</item>
        <item name="android:navigationBarColor">@color/home_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:colorAccent">@color/home_mint</item>
        <item name="android:colorControlNormal">@color/home_muted_text</item>
    </style>

    <style name="HomeCard">
        <item name="android:background">@drawable/home_panel</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">16dp</item>
    </style>

    <style name="HomeHeading">
        <item name="android:textColor">@color/home_muted_text</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.09</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="HomeAction">
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingHorizontal">14dp</item>
        <item name="android:paddingVertical">8dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/home_action_text</item>
        <item name="android:background">@drawable/home_action</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="HomePrimaryAction" parent="HomeAction">
        <item name="android:background">@drawable/home_primary_action</item>
        <item name="android:textColor">@color/home_primary_text</item>
    </style>
</resources>
