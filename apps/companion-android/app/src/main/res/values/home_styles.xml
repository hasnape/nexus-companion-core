<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="home_background">#070E1B</color>
    <color name="home_panel">#111D31</color>
    <color name="home_outline">#355373</color>
    <color name="home_inset">#0A1728</color>
    <color name="home_control">#1C344C</color>
    <color name="home_text">#F1F5FC</color>
    <color name="home_muted_text">#B3C0D5</color>
    <color name="home_mint">#7CF1DD</color>
    <color name="home_violet">#B7B4FF</color>
    <color name="home_sky">#8AD6FF</color>
    <color name="home_warning">#FFD1BC</color>

    <style name="NexusHomeTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/home_background</item>
        <item name="android:statusBarColor">@color/home_background</item>
        <item name="android:navigationBarColor">@color/home_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:colorAccent">@color/home_mint</item>
        <item name="android:colorControlNormal">@color/home_muted_text</item>
    </style>

    <style name="HomeCard">
        <item name="android:background">@drawable/home_panel</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">18dp</item>
    </style>

    <style name="HomeHeading">
        <item name="android:textColor">@color/home_muted_text</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.13</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="HomeAction">
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingHorizontal">14dp</item>
        <item name="android:paddingVertical">8dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/home_action_text</item>
        <item name="android:background">@drawable/home_action</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="HomePrimaryAction" parent="HomeAction">
        <item name="android:background">@drawable/home_primary_action</item>
        <item name="android:textColor">@color/home_primary_text</item>
    </style>
</resources>
