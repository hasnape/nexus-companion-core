{
  "version": 1,
  "language": "fr",
  "description": "Exemples de dialogue communs, non assimilables à des souvenirs personnels.",
  "dialogues": [
    {
      "id": "greeting",
      "intent": "greeting",
      "patterns": [
        "bonjour",
        "salut",
        "coucou",
        "bonsoir"
      ],
      "responses": [
        "Bonjour ! Comment vas-tu ?",
        "Salut ! Je t'écoute.",
        "Bonsoir ! Comment s'est passée ta journée ?"
      ]
    },
    {
      "id": "thanks",
      "intent": "thanks",
      "patterns": [
        "merci",
        "merci beaucoup",
        "je te remercie"
      ],
      "responses": [
        "Avec plaisir !",
        "Je t'en prie.",
        "Heureux d'avoir pu aider."
      ]
    },
    {
      "id": "apology",
      "intent": "apology",
      "patterns": [
        "pardon",
        "excuse-moi",
        "désolé"
      ],
      "responses": [
        "Aucun souci.",
        "Pas de problème, je t'écoute."
      ]
    },
    {
      "id": "goodbye",
      "intent": "goodbye",
      "patterns": [
        "au revoir",
        "à bientôt",
        "à demain",
        "bonne nuit"
      ],
      "responses": [
        "À bientôt !",
        "À demain, prends soin de toi.",
        "Bonne nuit, repose-toi bien."
      ]
    },
    {
      "id": "identity",
      "intent": "identity",
      "patterns": [
        "comment tu t'appelles",
        "qui es-tu",
        "quel est ton nom"
      ],
      "responses": [
        "Je suis ton compagnon Nexus. Mon nom dépend de mon profil actif."
      ]
    },
    {
      "id": "status",
      "intent": "status",
      "patterns": [
        "comment ça va",
        "ça va",
        "tu vas bien"
      ],
      "responses": [
        "Je suis disponible pour discuter. Et toi, comment vas-tu ?"
      ]
    },
    {
      "id": "sadness",
      "intent": "emotion_sadness",
      "patterns": [
        "je suis triste",
        "je me sens seul",
        "je suis déçu"
      ],
      "responses": [
        "Je suis là pour t'écouter si tu veux en parler.",
        "Tu veux me raconter ce qui s'est passé ?"
      ]
    },
    {
      "id": "joy",
      "intent": "emotion_joy",
      "patterns": [
        "je suis heureux",
        "je suis content",
        "j'ai réussi"
      ],
      "responses": [
        "Quelle bonne nouvelle !",
        "Tu veux me raconter ?"
      ]
    },
    {
      "id": "stop",
      "intent": "stop",
      "patterns": [
        "stop",
        "arrête",
        "silence"
      ],
      "responses": [
        "D'accord, j'arrête."
      ]
    },
    {
      "id": "repeat",
      "intent": "repeat",
      "patterns": [
        "répète",
        "je n'ai pas compris"
      ],
      "responses": [
        "Bien sûr, je vais reformuler."
      ]
    }
  ]
}
